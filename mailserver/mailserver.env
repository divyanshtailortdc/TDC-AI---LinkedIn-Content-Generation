# docker-mailserver 16 settings for a receive-only server. Every variable is
# documented in the upstream mailserver.env:
# https://github.com/docker-mailserver/docker-mailserver/blob/v16.0.1/mailserver.env
# No secrets here: the mailbox password is set by setup.sh.

LOG_LEVEL=info
ENABLE_UPDATE_CHECK=0
PERMIT_DOCKER=none

# Mail is only received. DKIM signing is for sending; Rspamd does the SPF,
# DKIM and DMARC checks of incoming mail itself, so the separate milters are off.
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0

# Spam filtering. No greylisting: it delays the confirmation emails
# publishers send when someone subscribes.
ENABLE_RSPAMD=1
RSPAMD_GREYLISTING=0
# Mail Rspamd only marks as spam stays in INBOX, the one folder the app
# reads: newsletters, heavy with links and images, sometimes score that high
# and would otherwise vanish into Junk. Clear spam is still rejected.
MOVE_SPAM_TO_JUNK=0

# IMAP only, for the app.
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_MANAGESIEVE=0

# One shared mailbox; the app keeps its own copy of every email.
ENABLE_QUOTAS=0
# 25 MB, as Gmail accepts.
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
