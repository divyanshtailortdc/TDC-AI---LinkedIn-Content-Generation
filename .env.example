APP_ENV="development"
# "all" serves pages and runs the job worker and scheduler, as in development;
# production can split them into "web" and "worker" services (terraform/README.md).
APP_ROLE="all"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tdc_linkedin_engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Gateway (also required for knowledge-base embeddings)
AI_GATEWAY_API_KEY=""

# AI Model Provider Credentials
ANTHROPIC_API_KEY=""

# Web Search
SERPER_API_KEY=""

# Background Jobs / Cron Secret
CRON_SECRET=""

# Authentication (see docs/AUTHENTICATION.md)
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The URL people open the app at. Each social sign-in provider must allow
# {BETTER_AUTH_URL}/api/auth/callback/{provider} (google, linkedin) as a
# redirect URI, and passkeys only work on this URL's host name.
BETTER_AUTH_URL=""

# Social sign-in providers (src/lib/auth-providers.ts): set at least one, as
# they are the only ways to create an account (a passkey can only be added
# once signed in). Each button shows only when both of its values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Publishing (optional; see docs/PUBLISHING.md). Its own OAuth flow, separate
# from sign-in: users connect the platform in Settings → Integrations.
# Publishing is off until the platform's id and secret and the encryption key
# are all set.
# Encrypts platform tokens at rest (AES-256-GCM). 32 bytes: openssl rand -base64 32
# Changing it makes every saved connection unreadable: users must reconnect.
# (LINKEDIN_TOKEN_ENCRYPTION_KEY, its old name, is still read.)
TOKEN_ENCRYPTION_KEY=""

# The LinkedIn publishing provider. Use a separate LinkedIn app with the
# "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect"
# products: LinkedIn invalidates a member's tokens when one app is authorized
# with different scopes, so sharing the sign-in app disconnects publishing on
# every LinkedIn sign-in.
LINKEDIN_PUBLISH_CLIENT_ID=""
LINKEDIN_PUBLISH_CLIENT_SECRET=""
# Register this exact URL in the LinkedIn app. Defaults to
# {BETTER_AUTH_URL}/api/integrations/linkedin/callback; set it for an HTTPS
# tunnel locally.
LINKEDIN_PUBLISH_REDIRECT_URI=""
# Only scopes the LinkedIn app has been granted; w_member_social is required.
LINKEDIN_PUBLISH_SCOPES="openid profile w_member_social"
# The LinkedIn-Version header (YYYYMM). Versions are supported for about a year.
LINKEDIN_API_VERSION="202610"

# The X provider, through Buffer (docs/PUBLISHING_X.md). Each user connects X
# in their own Buffer account and pastes a Buffer API key in Settings →
# Integrations, so the app needs no X or Buffer credentials of its own. On
# whenever TOKEN_ENCRYPTION_KEY is set; "off" hides it. Buffer fetches post
# images from BETTER_AUTH_URL, so that must be reachable from the internet.
X_PUBLISHING="buffer"
# FACEBOOK_PUBLISHING="buffer"
# INSTAGRAM_PUBLISHING="buffer"
# BUFFER_API_URL="https://api.buffer.com"
# Where Buffer downloads post images from, when not BETTER_AUTH_URL. Buffer
# cannot reach localhost: locally, run `cloudflared tunnel --url
# http://localhost:3000` and put its https://….trycloudflare.com address here.
# PUBLISHING_MEDIA_URL=""
# The Buffer app client (Buffer → Settings → API → App Clients → New Client,
# private): customers connect X on Buffer's consent screen. Unset, each user
# pastes a Buffer API key instead (fine for testing). Buffer requires an HTTPS
# redirect URI, even locally: run `npm run dev:https` and register
# https://localhost:3000/api/integrations/x/callback on the app client.
BUFFER_CLIENT_ID=""
# Confidential clients only. A public client has no secret: leave this empty,
# or Buffer refuses the token request ("client authentication failed").
BUFFER_CLIENT_SECRET=""
# Defaults to {BETTER_AUTH_URL}/api/integrations/x/callback.
BUFFER_REDIRECT_URI=""
BUFFER_SCOPES="account:read posts:read posts:write offline_access"

# Inbox (optional): our own mail server, see mailserver/README.md. Every
# address at INBOUND_EMAIL_DOMAIN delivers into one IMAP mailbox the app reads;
# mailserver/setup.sh prints these values. Unset, the inbox is off.
# Production: "inbox.tdcai.com". Local: the domain given to setup.sh (in.tdc.test).
INBOUND_EMAIL_DOMAIN=""
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT="993"
MAIL_IMAP_USER=""
MAIL_IMAP_PASSWORD=""
# Local only: the CA of the self-signed certificate (~/.tdc-mailserver/config/ssl/demoCA/cacert.pem)
MAIL_IMAP_TLS_CA_FILE=""
# Inbox through Cloudflare Email Routing (optional, with or without IMAP), see
# cloudflare/email-worker/README.md: the secret the Email Worker signs each
# email it posts to /api/mail/inbound with. Needs INBOUND_EMAIL_DOMAIN.
# Generate with: openssl rand -base64 32 (another value in production).
MAIL_WEBHOOK_SECRET=""

# Comma-separated auth user ids that are always administrators (optional)
ADMIN_USER_IDS=""

# Post images, in any S3-compatible store (optional). Unset, images stay in the
# database as base64. Moving hosts only changes these values:
#   Google Cloud Storage: STORAGE_ENDPOINT="https://storage.googleapis.com",
#     STORAGE_REGION="auto", and an HMAC key of a service account
#   Cloudflare R2: STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com",
#     STORAGE_REGION="auto", and an R2 API token's S3 keys
#   AWS S3: leave STORAGE_ENDPOINT empty, set the bucket's STORAGE_REGION
#   Local S3 server (RustFS, MinIO): STORAGE_ENDPOINT="http://127.0.0.1:9000"
#     and its root user and password as the keys
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

INBOUND_EMAIL_DOMAIN="in.tdc.test"
MAIL_WEBHOOK_SECRET="PkjISkeModu7fUmW9580dKukbqtcBDnIiUON8Sgbq18="

# TO Send Mail using Cloudflare Email Routing (optional, with or without IMAP), see
# cd ~/Desktop/tdc-ai-linkedin-content-generation/cloudflare/email-worker && npm run dev

# test
# curl -s -w " [%{http_code}]\n" -X POST http://localhost:3000/api/mail/inbound -d '{}'

# message send 
# curl -s -X POST 'http://localhost:8787/cdn-cgi/local/email' \
#   --url-query 'from=news@substack.com' --url-query 'to=divyansh@in.tdc.test' \
#   --data-binary $'From: "Substack" <news@substack.com>\r\nSubject: Cloudflare test 1\r\nMessage-ID: <cf-test-1@substack.com>\r\nContent-Type: text/html\r\n\r\n<h1>Hello</h1><p>Via Cloudflare.</p>'; echo
