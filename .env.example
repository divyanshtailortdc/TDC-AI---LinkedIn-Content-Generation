APP_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tdc_linkedin_engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Gateway (also required for knowledge-base embeddings)
AI_GATEWAY_API_KEY=""

# AI Model Provider Credentials
ANTHROPIC_API_KEY=""

# Web Search
SERPER_API_KEY=""

# Background Jobs / Cron Secret
CRON_SECRET=""

# Authentication (see docs/AUTHENTICATION.md)
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The URL people open the app at. Google and LinkedIn must allow
# {BETTER_AUTH_URL}/api/auth/callback/{google,linkedin} as redirect URIs, and
# passkeys only work on this URL's host name.
BETTER_AUTH_URL=""

# Google and LinkedIn sign-in: set at least one, as they are the only ways to
# create an account (a passkey can only be added once signed in). Each button
# shows only when both of its values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Comma-separated auth user ids that are always administrators (optional)
ADMIN_USER_IDS=""

# Post images, in any S3-compatible store (optional). Unset, images stay in the
# database as base64. Moving hosts only changes these values:
#   Google Cloud Storage: STORAGE_ENDPOINT="https://storage.googleapis.com",
#     STORAGE_REGION="auto", and an HMAC key of a service account
#   Cloudflare R2: STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com",
#     STORAGE_REGION="auto", and an R2 API token's S3 keys
#   AWS S3: leave STORAGE_ENDPOINT empty, set the bucket's STORAGE_REGION
#   Local S3 server (RustFS, MinIO): STORAGE_ENDPOINT="http://127.0.0.1:9000"
#     and its root user and password as the keys
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
