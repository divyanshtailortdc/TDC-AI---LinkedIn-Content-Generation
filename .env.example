APP_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tdc_linkedin_engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Gateway (also required for knowledge-base embeddings)
AI_GATEWAY_API_KEY=""

# AI Model Provider Credentials
ANTHROPIC_API_KEY=""

# Web Search
SERPER_API_KEY=""

# Background Jobs / Cron Secret
CRON_SECRET=""

# Authentication (see docs/AUTHENTICATION.md)
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The URL people open the app at. Google and LinkedIn must allow
# {BETTER_AUTH_URL}/api/auth/callback/{google,linkedin} as redirect URIs, and
# passkeys only work on this URL's host name.
BETTER_AUTH_URL="http://localhost:3000"

# Google and LinkedIn sign-in: set at least one, as they are the only ways to
# create an account (a passkey can only be added once signed in). Each button
# shows only when both of its values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Comma-separated auth user ids that are always administrators (optional)
ADMIN_USER_IDS=""
