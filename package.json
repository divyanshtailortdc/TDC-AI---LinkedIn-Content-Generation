{
  "name": "tdc-ai-content-generation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --require ./tests/support/server-only-stub.cjs --test tests/**/*.test.ts",
    "format": "prettier --write \"./src/**/*.{js,cjs,mjs,jsx,ts,tsx,mdx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docs:index": "tsx --env-file-if-exists=.env src/docs/scripts/build-search-index.ts",
    "docs:screenshots": "node scripts/docs-screenshots/capture.mjs",
    "video:sample": "tsx src/lib/video/render/scripts/sample.ts",
    "video:check": "tsx src/lib/video/render/scripts/check.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.52",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@better-auth/passkey": "1.6.11",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.4",
    "@sparticuz/chromium": "153.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "ai": "^7.0.97",
    "better-auth": "1.6.11",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "5.3.0",
    "imapflow": "^2.10.0",
    "lucide-react": "^1.44.0",
    "mailparser": "^3.14.1",
    "next": "16.3.4",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "html-validate": "11.21.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
